{
  "schema_version": 5,
  "platform_api": 1,
  "platform_name": "AutomationPlatform",
  "repository": {
    "owner": "1777maxim7771",
    "name": "AutomationPlatform",
    "branch": "main",
    "url": "https://github.com/1777maxim7771/AutomationPlatform",
    "raw_base": "https://raw.githubusercontent.com/1777maxim7771/AutomationPlatform/main/"
  },
  "installer": {
    "starter": "START_PLATFORM_INSTALLER.ps1",
    "core": "INSTALLER_CORE.ps1",
    "bootstrap_ps1": "INSTALL_AutomationPlatform.ps1",
    "bootstrap_bat": "INSTALL_AutomationPlatform.bat",
    "repair_on_rerun": true,
    "reuse_downloads": true
  },
  "control_center": {
    "version": "0.4.0",
    "package_path": "packages/AutomationPlatform_ControlCenter_v0.4.0.zip",
    "sha256": "99baaeb7246ff72689e2033fe9ce6eb4044981e1327ae1f6b17b0fe705512191"
  },
  "python": {
    "version": "3.13.14",
    "method": "embed_first",
    "installer_url": "https://www.python.org/ftp/python/3.13.14/python-3.13.14-amd64.exe",
    "embed_url": "https://www.python.org/ftp/python/3.13.14/python-3.13.14-embed-amd64.zip",
    "get_pip_url": "https://bootstrap.pypa.io/get-pip.py",
    "sha256": "c54d9b9bbb8a36e6489363ddd01139707fd781d72f1f9e90c7ec65d0061368e0"
  },
  "chrome": {
    "required": true,
    "prefer_system_chrome": true,
    "install_google_chrome_if_missing": true,
    "abort_if_chrome_missing": true,
    "use_chrome_for_testing": false,
    "google_chrome_installer_url": "https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise64.msi",
    "google_chrome_installer_kind": "msi",
    "debug_port": 9222,
    "launch_args": [
      "--remote-debugging-port=9222",
      "--remote-allow-origins=*",
      "--no-first-run",
      "--no-default-browser-check",
      "--disable-popup-blocking"
    ],
    "start_urls": ["https://chatgpt.com"],
    "system_chrome_paths": [
      "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe",
      "%ProgramFiles(x86)%\\Google\\Chrome\\Application\\chrome.exe",
      "%LocalAppData%\\Google\\Chrome\\Application\\chrome.exe"
    ]
  },
  "defaults": {
    "install_root": "D:\\AutomationPlatform",
    "debug_port": 9222,
    "cdp_host": "127.0.0.1",
    "chrome_profile": "browser\\Chrome_Profile",
    "python_dir": "runtime\\python",
    "chrome_dir": "runtime\\chrome",
    "logs_dir": "logs",
    "modules_dir": "modules",
    "data_dir": "data",
    "jobs_dir": "jobs",
    "install_python": true,
    "install_chrome": true,
    "install_control_center": true,
    "create_chrome_profile": true,
    "open_control_center_after_install": true
  },
  "preserve_on_update": [
    "browser\\Chrome_Profile",
    "data\\shared_values.json",
    "data\\secrets.dpapi.json",
    "modules",
    "jobs",
    "logs"
  ]
}
