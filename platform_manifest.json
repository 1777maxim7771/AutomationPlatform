{
  "schema_version": 14,
  "platform_api": 1,
  "platform_name": "AutomationPlatform",
  "repository": {
    "owner": "1777maxim7771",
    "name": "AutomationPlatform",
    "branch": "main",
    "url": "https://github.com/1777maxim7771/AutomationPlatform",
    "raw_base": "https://raw.githubusercontent.com/1777maxim7771/AutomationPlatform/main/"
  },
  "shell": {
    "version": "0.1.0",
    "source": "CONTROL_CENTER_SHELL.py",
    "installed_path": "control_center\\shell.py",
    "module_ui_api": 1,
    "single_window": true,
    "cache_module_views": true,
    "dynamic_module_menu": true,
    "module_catalog": "modules_catalog.json"
  },
  "installer": {
    "bootstrap_bat": "INSTALL_AutomationPlatform.bat",
    "installer_ui": "INSTALLER_UI.ps1",
    "legacy_ui_forwarder": "START_PLATFORM_INSTALLER.ps1",
    "bootstrap_runner": "BOOTSTRAP_RUNNER.ps1",
    "python_runtime_manager": "PYTHON_RUNTIME_MANAGER.ps1",
    "chrome_runtime_manager": "CHROME_RUNTIME_MANAGER.ps1",
    "platform_finalizer": "PLATFORM_FINALIZER.ps1",
    "optional_modules_manager": "OPTIONAL_MODULES_MANAGER.ps1",
    "legacy_core": "INSTALLER_CORE.ps1",
    "mode": "install_update_repair",
    "always_refresh_installer_ui": true,
    "always_refresh_bootstrap_logic": true,
    "reuse_valid_downloads": true,
    "write_detailed_logs": true,
    "write_status_json": true,
    "live_log": "logs\\latest_bootstrap.log"
  },
  "control_center": {
    "version": "0.5.1",
    "encoding": "base64-parts",
    "package_path": "packages/control_center_v0.5.0.part01.b64",
    "package_parts": [
      "packages/control_center_v0.5.0.part01.b64",
      "packages/control_center_v0.5.0.part02.b64",
      "packages/control_center_v0.5.0.part03.b64",
      "packages/control_center_v0.5.0.part04.b64"
    ],
    "sha256": "347948bc0d5d8779e12f8cf8add30210c5acfa15dda2a8c936033e3e246a449e",
    "post_extract_compatibility_patch": "fxbutton_tkinter_reserved_widget_path_v1",
    "required_files": [
      "control_center\\gui.py",
      "core\\router.py"
    ]
  },
  "python": {
    "version": "3.13.14",
    "method": "official_pythoncore_runtime_zip",
    "application_local": true,
    "require_tkinter": true,
    "require_pip": true,
    "runtime_url": "https://www.python.org/ftp/python/3.13.14/python-3.13.14-amd64.zip",
    "runtime_sha256": "f73b6535281b58eee6bcfb3403af2bcfac711ea1463d8340c47c3047248eddf7",
    "release_manifest_url": "https://www.python.org/ftp/python/3.13.14/windows-3.13.14.json",
    "legacy_installer_url": "https://www.python.org/ftp/python/3.13.14/python-3.13.14-amd64.exe",
    "legacy_installer_sha256": "c54d9b9bbb8a36e6489363ddd01139707fd781d72f1f9e90c7ec65d0061368e0"
  },
  "chrome": {
    "required": true,
    "prefer_system_chrome": true,
    "install_google_chrome_if_missing": true,
    "managed_update": true,
    "update_if_older_than_stable": false,
    "update_manager": "CHROME_RUNTIME_MANAGER.ps1",
    "defer_update_while_running": true,
    "nonfatal_update_failure_when_existing_chrome_healthy": true,
    "use_chrome_for_testing": false,
    "stable_version_url": "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions.json",
    "google_chrome_installer_url": "https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise64.msi",
    "google_chrome_installer_kind": "msi",
    "debug_port": 9222,
    "prompt_for_start_url_when_missing": true,
    "start_url_value_key": "browser.start_url",
    "launch_args": [
      "--remote-debugging-port=9222",
      "--remote-allow-origins=*",
      "--no-first-run",
      "--no-default-browser-check",
      "--disable-popup-blocking",
      "--disable-session-crashed-bubble",
      "--hide-crash-restore-bubble"
    ],
    "start_urls": [],
    "system_chrome_paths": [
      "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe",
      "%ProgramFiles(x86)%\\Google\\Chrome\\Application\\chrome.exe",
      "%LocalAppData%\\Google\\Chrome\\Application\\chrome.exe"
    ]
  },
  "optional_modules": {
    "dynamic_conversation_exporter": {
      "id": "dynamic_conversation_exporter",
      "name": "Dynamic Conversation Exporter",
      "version": "1.6.0",
      "repository": "https://github.com/1777maxim7771/Dynamic_Conversation_Exporter",
      "manifest_url": "https://raw.githubusercontent.com/1777maxim7771/Dynamic_Conversation_Exporter/main/module_manifest.json",
      "install_directory": "modules\\dynamic_conversation_exporter",
      "default_install": false,
      "auto_update_if_installed": true,
      "ui_mode": "embedded",
      "ui_api": 1,
      "single_window": true,
      "description": "ChatGPT Dynamic Conversation Exporter v1.6 with partial-pair and attachment export, using the shared AutomationPlatform Chrome Debug/CDP connection and the original working panel embedded in the single-window shell."
    }
  },
  "defaults": {
    "install_root": "D:\\AutomationPlatform",
    "debug_port": 9222,
    "cdp_host": "127.0.0.1",
    "chrome_profile": "browser\\Chrome_Profile",
    "python_dir": "runtime\\python",
    "logs_dir": "logs",
    "modules_dir": "modules",
    "data_dir": "data",
    "jobs_dir": "jobs",
    "open_control_center_after_install": true
  },
  "preserve_on_update": [
    "browser\\Chrome_Profile",
    "data\\shared_values.json",
    "data\\secrets.dpapi.json",
    "modules",
    "jobs",
    "logs"
  ]
}
